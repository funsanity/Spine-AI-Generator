# ── 依赖 ───────────────────────────────────────────────────────────────
node_modules/

# ── 密钥与本机配置 ──────────────────────────────────────────────────────
# .env 里有 API Key 和你的实际接入点地址，绝不能被推到仓库
.env
.env.local
.env.*.local

# ── 运行产物 ───────────────────────────────────────────────────────────
output/
roundtrip-out/
uploads/

# ── MobileSAM 的重东西（约 200MB，可随时重新下载）────────────────────────
# 权重: scripts/_mobilesam_weights/mobile_sam.pt
# 仓库: scripts/MobileSAM/
# 注意：MobileSAM 的源码目录是 setup.mjs 拉下来的，
# 但 ~/.spine-tool 才是运行时真正用的那份，这里只是开发时的副本。
scripts/MobileSAM/
scripts/_mobilesam_weights/

# ── Python ─────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc

# ── 排查脚本归档 ───────────────────────────────────────────────────────
# 这些是查特定问题的一次性脚本，留着复核结论有用，但不是工具的组成部分。
# 详见 scripts/_debug/README.md
scripts/_debug/

# ── 测试与临时 ─────────────────────────────────────────────────────────
# temp/ 里 temp/test/ 是**正式测试套件**（npm test 跑的就是它），必须跟踪，
# 所以不能整目录忽略。下面只挡临时产物。
temp/test/tmp/
temp/*.log
*.tmp

# 排查用的录屏/音频。这些是"看一遍就懂"的一次性素材，几百 MB 起步，
# 进仓库纯属占地方，而且 git 历史里的二进制删不掉。
# 注意：这一条不能写成 temp/ 整目录——temp/test/ 整个会跟着消失。
temp/*.mp4
temp/*.mov
temp/*.m4v
temp/*.webm
temp/*.wav

# ── 编辑器 / 系统 ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── 本地草稿 ───────────────────────────────────────────────────────────
# 想留但不能进仓库的东西放这儿。
# 必须写成 /notes/ 这种带前导斜杠的形式锚在根目录：不加斜杠 git 会在
# **任意层级**匹配同名目录，把 docs/notes/（正文档）也一起忽略掉。
/notes/
/scratch/

# Claude Code 的本机设置（含本机路径与授权记录）
.claude/settings.local.json
