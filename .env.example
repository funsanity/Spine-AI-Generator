# Spine AI Generator 配置文件
# 复制此文件为 .env 并填入你的配置

# ── API 配置 ───────────────────────────────────────────────────────────
# 两种用法，任选其一：
#
#   1) 直连 Anthropic 官方：两个都留空即可，SDK 会用官方地址。
#   2) 自建网关 / 中转服务：填你自己的服务地址和 Key。
#
# 想改界面上表单的默认值（而不是只在本机生效），改
# config/api-defaults.json —— 那是默认值的唯一源头。
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# ── 服务 ───────────────────────────────────────────────────────────────
# 监听端口（可选，默认 3000）
PORT=3000

# 导出产物根目录（可选，默认 ./output）
OUTPUT_DIR=./output

# ── Spine 编辑器（可选）─────────────────────────────────────────────────
# 用来把骨架导成可二次编辑的 .spine 工程。不填就自动找
# /Applications/Spine.app（macOS）等常见安装位置；找不到只跳过这一步，
# 不影响目标平台资源的产出。
# SPINE_CLI_PATH=/Applications/Spine.app/Contents/MacOS/Spine

# ── 像素级分割（可选）───────────────────────────────────────────────────
# 两个分割器，二选一。默认 mobilesam。
#
#   mobilesam —— 框提示。每部件 10~25ms，环境 585MB。绝大多数图够用。
#   sam3      —— 文本提示。每部件约 4.5s，环境 4GB（含 3.4GB 权重）。
#                框里装了两件东西时（眼镜 vs 脸）不会挑错，细碎部件靠它。
#
# 换 sam3 是为了治具体的病，不是普遍升级。装法见 README。
# SPINE_SEGMENTER=mobilesam

# 两个分割器各自的虚拟环境位置，默认 ~/.spine-tool/mobilesam 和 ~/.spine-tool/sam3。
# 注意是两套独立环境，不能指到同一个目录：依赖版本冲突（Python 3.9 vs 3.12）。
# SPINE_SAM_HOME=
# SPINE_SAM3_HOME=
