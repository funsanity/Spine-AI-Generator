# Spine AI Generator 配置文件
# 复制此文件为 .env 并填入你的配置

# ── API 配置 ───────────────────────────────────────────────────────────
# 两种用法，任选其一：
#
#   1) 直连 Anthropic 官方：两个都留空即可，SDK 会用官方地址。
#   2) 自建网关 / 中转服务：填你自己的服务地址和 Key。
#
# 想改界面上表单的默认值（而不是只在本机生效），改
# config/api-defaults.json —— 那是默认值的唯一源头。
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# ── 服务 ───────────────────────────────────────────────────────────────
# 监听端口（可选，默认 3000）
PORT=3000

# 导出产物根目录（可选，默认 ./output）
OUTPUT_DIR=./output

# ── Spine 编辑器（可选）─────────────────────────────────────────────────
# 用来把骨架导成可二次编辑的 .spine 工程。不填就自动找
# /Applications/Spine.app（macOS）等常见安装位置；找不到只跳过这一步，
# 不影响 .json / .atlas / .png 三件套。
# SPINE_CLI_PATH=/Applications/Spine.app/Contents/MacOS/Spine

# ── MobileSAM 环境（可选）───────────────────────────────────────────────
# 像素级分割用的 Python 虚拟环境位置，默认 ~/.spine-tool/mobilesam
# SPINE_SAM_HOME=
